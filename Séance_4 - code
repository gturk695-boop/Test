# PARTIE B — Programmation orientée objet
# ============================================

class SerieTaux:
    """Regroupe les taux d'une devise et les opérations pour les analyser."""

    source = "Frankfurter API"   # attribut de CLASSE : partagé par toutes les instances

    def __init__(self, devise, dates, taux):
        """Le constructeur : s'exécute automatiquement à la création d'un objet."""
        self.devise = devise
        self.dates = dates
        self.taux = taux

    def moyenne(self):
        """Calcule la moyenne des taux de cette série."""
        return sum(self.taux) / len(self.taux)

    def variation(self):
        """Calcule la variation en % entre le premier et le dernier taux."""
        return (self.taux[-1] - self.taux[0]) / self.taux[0] * 100

    def taux_a_date(self, date_recherchee):
        """Renvoie le taux correspondant à une date donnée, ou None si absente."""
        for date, valeur in zip(self.dates, self.taux):
            if date == date_recherchee:
                return valeur
        return None


serie_usd = SerieTaux("USD", ["2026-01-01", "2026-01-02", "2026-01-05"], [1.05, 1.06, 1.04])

print("Devise:", serie_usd.devise)
print("Moyenne USD:", serie_usd.moyenne())
print("Variation USD:", serie_usd.variation())
print("Taux au 2026-01-02:", serie_usd.taux_a_date("2026-01-02"))
print("Taux au 2026-01-09 (absent):", serie_usd.taux_a_date("2026-01-09"))

# --- B.2 : plusieurs objets, attribut de classe vs attribut d'instance ---
serie_gbp = SerieTaux("GBP", ["2026-01-01", "2026-01-02", "2026-01-05"], [0.87, 0.88, 0.86])

print("Devise USD:", serie_usd.devise, "- Moyenne:", serie_usd.moyenne())
print("Devise GBP:", serie_gbp.devise, "- Moyenne:", serie_gbp.moyenne())
print("Source USD:", serie_usd.source)
print("Source GBP:", serie_gbp.source)

# --- B.2 (piège) : attribut de classe MUTABLE, à ne pas reproduire ---
class Compteur:
    historique = []   # attribut de classe, mais c'est une LISTE (mutable) -> DANGER

    def __init__(self, nom):
        self.nom = nom

    def ajouter(self, texte):
        self.historique.append(texte)

c1 = Compteur("premier")
c2 = Compteur("deuxieme")
c1.ajouter("action de c1")

print("Historique de c1:", c1.historique)
print("Historique de c2:", c2.historique)   # affiche aussi "action de c1" : c'est le piège !

# --- B.3 : dataclasses ---
from dataclasses import dataclass

@dataclass
class Point:
    """Un point simple avec une date et un taux, écrit avec @dataclass."""
    date: str
    taux: float

p1 = Point("2026-01-01", 1.05)
print(p1)
print("Date:", p1.date)
print("Taux:", p1.taux)


