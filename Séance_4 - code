import ssl
import certifi
ssl._create_default_https_context = lambda: ssl.create_default_context(cafile=certifi.where())

import matplotlib.pyplot as plt
import urllib.request
import json

# --- C.1 : récupération des taux USD et premier graphique ---
url = "https://api.frankfurter.app/2026-01-01..2026-01-31?from=EUR&to=USD"
requete = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
reponse = urllib.request.urlopen(requete)
donnees = json.loads(reponse.read())

dates_c = sorted(donnees["rates"].keys())
taux_c = [donnees["rates"][date]["USD"] for date in dates_c]

fig, ax = plt.subplots()
ax.plot(dates_c, taux_c)
ax.set_title("Taux EUR/USD - Janvier 2026")
ax.set_xlabel("Date")
ax.set_ylabel("Taux USD")
plt.xticks(rotation=45)
plt.tight_layout()
fig.savefig("graphique_usd.png")
print("C.1 : graphique_usd.png sauvegardé")

# --- C.2 : récupération des taux GBP, comparaison, histogramme, subplots ---
url_gbp = "https://api.frankfurter.app/2026-01-01..2026-01-31?from=EUR&to=GBP"
requete_gbp = urllib.request.Request(url_gbp, headers={"User-Agent": "Mozilla/5.0"})
reponse_gbp = urllib.request.urlopen(requete_gbp)
donnees_gbp = json.loads(reponse_gbp.read())

dates_gbp = sorted(donnees_gbp["rates"].keys())
taux_gbp = [donnees_gbp["rates"][date]["GBP"] for date in dates_gbp]

fig1, ax1 = plt.subplots()
ax1.plot(dates_c, taux_c, label="EUR/USD")
ax1.plot(dates_gbp, taux_gbp, label="EUR/GBP")
ax1.set_title("Comparaison USD vs GBP - Janvier 2026")
ax1.set_xlabel("Date")
ax1.set_ylabel("Taux")
ax1.legend()
plt.xticks(rotation=45)
plt.tight_layout()
fig1.savefig("comparaison_usd_gbp.png")

variations_c = [taux_c[i] - taux_c[i-1] for i in range(1, len(taux_c))]

fig2, ax2 = plt.subplots()
ax2.hist(variations_c, bins=10)
ax2.set_title("Distribution des variations quotidiennes USD")
ax2.set_xlabel("Variation")
ax2.set_ylabel("Fréquence")
plt.tight_layout()
fig2.savefig("histogramme_variations.png")

fig3, axes = plt.subplots(1, 2, figsize=(10, 4))
axes[0].plot(dates_c, taux_c)
axes[0].set_title("USD")
axes[0].tick_params(axis='x', rotation=45)
axes[1].plot(dates_gbp, taux_gbp)
axes[1].set_title("GBP")
axes[1].tick_params(axis='x', rotation=45)
plt.tight_layout()
fig3.savefig("subplots_usd_gbp.png")

print("C.2 : trois graphiques sauvegardés (comparaison, histogramme, subplots)")


