import argparse

def extraire():
    print("Extraction des données depuis l'API...")

def analyser():
    print("Analyse des données...")

def graphiques():
    print("Génération des graphiques...")


def main():
    parser = argparse.ArgumentParser(description="Outil d'analyse des taux de change")
    sous_commandes = parser.add_subparsers(dest="commande")

    sous_commandes.add_parser("extraire")
    sous_commandes.add_parser("analyser")
    sous_commandes.add_parser("graphiques")

    args = parser.parse_args()

    if args.commande == "extraire":
        extraire()
    elif args.commande == "analyser":
        analyser()
    elif args.commande == "graphiques":
        graphiques()
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
